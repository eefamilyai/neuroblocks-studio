{
  "name": "neuroblocks-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Scratch-style visual studio for training neural network agents in a 3D world, with every bit of the machine learning exposed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings tests/run.ts",
    "test:export": "node --experimental-strip-types --no-warnings tests/export.gen.ts tests/.export && python3 tests/verify_export.py tests/.export",
    "bench": "node --experimental-strip-types --no-warnings tests/bench-mission.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "blockly": "^13.4.0",
    "codemirror": "^6.0.2",
    "lucide": "^1.68.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
