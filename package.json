{
  "name": "neuroblocks-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Scratch-style visual studio for training neural network agents in a 3D world, with every bit of the machine learning exposed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings tests/run.ts"
  },
  "dependencies": {
    "blockly": "^13.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
